# Environment
.env
.env.local

# Node
node_modules/
npm-debug.log*
dist/
coverage/
*.tsbuildinfo

# Editor/OS
.DS_Store
.vscode/
.idea/

# Certificates, private keys and env files (stackin-io/devops#47).
# A1 certificates (.pfx/.p12) and private keys must never be committed:
# a pushed secret is leaked for good, history rewrites don't undo it.
*.pfx
*.p12
*.pem
*.key
*.jks
*.keystore
*.p8
.env.*
!.env.example
