{
  "name": "@stackin-io/stackin-node-sdk",
  "version": "0.3.0",
  "description": "Node/TypeScript SDK for stackin — issue, consult and cancel Brazilian fiscal documents (NF-e, NFS-e) via a single Invoice client. No certificates, XML or SOAP.",
  "keywords": [
    "stackin",
    "nfe",
    "nf-e",
    "nfse",
    "nfs-e",
    "invoice",
    "fiscal",
    "fatura",
    "nota-fiscal",
    "nota-fiscal-eletronica",
    "sefaz",
    "brazil",
    "brasil",
    "sdk",
    "typescript",
    "nodejs",
    "api-client"
  ],
  "license": "MIT",
  "author": "stackin-io",
  "homepage": "https://github.com/stackin-io/stackin-node-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackin-io/stackin-node-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/stackin-io/stackin-node-sdk/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p .code_quality/tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint --config .code_quality/.eslintrc.json --no-eslintrc --ext .ts src tests examples",
    "format": "prettier --config .code_quality/.prettierrc.json --check \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "format:write": "prettier --config .code_quality/.prettierrc.json --write \"src/**/*.ts\" \"tests/**/*.ts\" \"examples/**/*.ts\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.0",
    "typescript": "^5.4.0",
    "undici": "^6.28.1",
    "vitest": "^1.4.0"
  }
}
