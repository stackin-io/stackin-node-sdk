{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "rootDir": "../src",
    "outDir": "../dist"
  },
  "include": ["../src/**/*"],
  "exclude": ["../node_modules", "../dist", "../examples", "../tests"]
}
